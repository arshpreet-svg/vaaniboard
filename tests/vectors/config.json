{
  "comment": "Profile validation cases shared by the firmware host tests (firmware/board/test_host) and the Studio simulator tests (studio/test). Each case starts from the defaults; `expect` lists the fields to compare; `warnings` lists the fields that must be reported, in any order.",
  "defaults": { "child": "C01", "lang": "hi", "mode": "direct", "hold_ms": 0, "lockout_ms": 1500, "scan_ms": 1500, "volume": 60, "listening": true },
  "cases": [
    { "name": "empty object changes nothing", "input": {}, "expect": {}, "warnings": [] },
    { "name": "full valid profile",
      "input": { "child": "C07", "lang": "ta", "mode": "scan", "hold_ms": 300, "lockout_ms": 2000, "scan_ms": 1200, "volume": 50, "listening": false },
      "expect": { "child": "C07", "lang": "ta", "mode": "scan", "hold_ms": 300, "lockout_ms": 2000, "scan_ms": 1200, "volume": 50, "listening": false },
      "warnings": [] },
    { "name": "ranges are clamped, not rejected",
      "input": { "hold_ms": 5000, "lockout_ms": 10, "scan_ms": 99999, "volume": 100 },
      "expect": { "hold_ms": 1000, "lockout_ms": 300, "scan_ms": 3000, "volume": 80 },
      "warnings": ["hold_ms", "lockout_ms", "scan_ms", "volume"] },
    { "name": "negative hold clamps to 0", "input": { "hold_ms": -5 }, "expect": { "hold_ms": 0 }, "warnings": ["hold_ms"] },
    { "name": "volume cap of 80 is enforced", "input": { "volume": 81 }, "expect": { "volume": 80 }, "warnings": ["volume"] },
    { "name": "unknown language is ignored", "input": { "lang": "xx" }, "expect": { "lang": "hi" }, "warnings": ["lang"] },
    { "name": "language must be a string", "input": { "lang": 3 }, "expect": { "lang": "hi" }, "warnings": ["lang"] },
    { "name": "child code with a comma is rejected (would corrupt EVT lines)", "input": { "child": "C0,1" }, "expect": { "child": "C01" }, "warnings": ["child"] },
    { "name": "child code longer than 7 is rejected", "input": { "child": "ABCDEFGH" }, "expect": { "child": "C01" }, "warnings": ["child"] },
    { "name": "child code of exactly 7 is accepted", "input": { "child": "ABC-12_" }, "expect": { "child": "ABC-12_" }, "warnings": [] },
    { "name": "empty child code is rejected", "input": { "child": "" }, "expect": { "child": "C01" }, "warnings": ["child"] },
    { "name": "child code with a space is rejected", "input": { "child": "Riya S" }, "expect": { "child": "C01" }, "warnings": ["child"] },
    { "name": "unknown mode is ignored", "input": { "mode": "auto" }, "expect": { "mode": "direct" }, "warnings": ["mode"] },
    { "name": "wrong types are ignored",
      "input": { "hold_ms": "300", "listening": "yes", "volume": 1.5 },
      "expect": { "hold_ms": 0, "listening": true, "volume": 60 },
      "warnings": ["hold_ms", "listening", "volume"] },
    { "name": "unknown field is reported", "input": { "colour": "red" }, "expect": {}, "warnings": ["colour"] },
    { "name": "read-only fields echoed from CFG are silent", "input": { "keys": 8, "fw": "0.2.0", "proto": 1, "langs": ["hi"] }, "expect": {}, "warnings": [] },
    { "name": "valid fields still apply next to invalid ones",
      "input": { "lang": "bn", "volume": "loud", "scan_ms": 2000 },
      "expect": { "lang": "bn", "volume": 60, "scan_ms": 2000 },
      "warnings": ["volume"] }
  ],
  "not_objects": ["[1,2]", "\"scan\"", "42", "null"]
}
